             ('ZDB-MREL-150506-66', 'ZDB-TGCONSTRCT-141217-4', 'ZDB-GENE-010614-1', 'promoter of'),
             ('ZDB-MREL-150506-67', 'ZDB-TGCONSTRCT-141218-5', 'ZDB-GENE-010813-1', 'promoter of'),
             ('ZDB-MREL-230318-1', 'ZDB-TGCONSTRCT-141218-7', 'ZDB-EREGION-070122-1', 'promoter of'),
             ('ZDB-MREL-150506-68', 'ZDB-TGCONSTRCT-150122-3', 'ZDB-EFG-080214-1', 'coding sequence of'),
             ('ZDB-MREL-150506-71', 'ZDB-TGCONSTRCT-150202-1', 'ZDB-EFG-070117-1', 'coding sequence of')
              ) AS c(mrel_id, construct_id, marker_id, rel_type)
              ON o.mrel_zdb_id = c.mrel_id
                  AND o.mrel_mrkr_1_zdb_id = c.construct_id
                  AND o.mrel_mrkr_2_zdb_id = c.marker_id
                  AND o.mrel_type = c.rel_type
WHERE NOT EXISTS (SELECT 1 FROM construct_marker_relationship x
                  WHERE x.conmrkrrel_construct_zdb_id = o.mrel_mrkr_1_zdb_id
                    AND x.conmrkrrel_mrkr_zdb_id = o.mrel_mrkr_2_zdb_id
                    AND x.conmrkrrel_relationship_type = o.mrel_type);

INSERT INTO zdb_active_data (zactvd_zdb_id) SELECT cmrel_id FROM tmp_partb_add;

INSERT INTO construct_marker_relationship (conmrkrrel_zdb_id, conmrkrrel_construct_zdb_id, conmrkrrel_mrkr_zdb_id, conmrkrrel_relationship_type)
SELECT cmrel_id, construct_id, marker_id, rel_type FROM tmp_partb_add;

-- attribution: copy the MREL's own attribution rows when it has any
INSERT INTO record_attribution (recattrib_data_zdb_id, recattrib_source_zdb_id, recattrib_source_significance, recattrib_source_type)
SELECT t.cmrel_id, ra.recattrib_source_zdb_id, ra.recattrib_source_significance, ra.recattrib_source_type
FROM tmp_partb_add t
         JOIN record_attribution ra ON ra.recattrib_data_zdb_id = t.mrel_zdb_id;

-- otherwise use the construct's first attribution
INSERT INTO record_attribution (recattrib_data_zdb_id, recattrib_source_zdb_id, recattrib_source_significance, recattrib_source_type)
SELECT t.cmrel_id, a.recattrib_source_zdb_id, a.recattrib_source_significance, a.recattrib_source_type
FROM tmp_partb_add t
         CROSS JOIN LATERAL (SELECT ra.recattrib_source_zdb_id, ra.recattrib_source_significance, ra.recattrib_source_type
                             FROM record_attribution ra
                             WHERE ra.recattrib_data_zdb_id = t.construct_id
                             ORDER BY ra.recattrib_pk_id
                             LIMIT 1) a
WHERE NOT EXISTS (SELECT 1 FROM record_attribution x WHERE x.recattrib_data_zdb_id = t.mrel_zdb_id);

DROP TABLE tmp_partb_add;
