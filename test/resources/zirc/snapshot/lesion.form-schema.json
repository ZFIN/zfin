{
  "schema" : {
    "properties" : {
      "additionalInfo" : {
        "maxLength" : 5000,
        "title" : "Additional Info",
        "type" : [ "string", "null" ]
      },
      "constructName" : {
        "maxLength" : 255,
        "title" : "Construct name",
        "type" : [ "string", "null" ]
      },
      "crisprSequence" : {
        "maxLength" : 5000,
        "title" : "CRISPR sequence",
        "type" : [ "string", "null" ]
      },
      "deletedSequence" : {
        "maxLength" : 5000,
        "title" : "Deleted sequence",
        "type" : [ "string", "null" ]
      },
      "fivePrimeFlank" : {
        "maxLength" : 5000,
        "title" : "5′ flanking sequence",
        "type" : [ "string", "null" ]
      },
      "hasLargeVariant" : {
        "title" : "Has large variant",
        "type" : [ "boolean", "null" ]
      },
      "insertedSequence" : {
        "maxLength" : 5000,
        "title" : "Inserted sequence",
        "type" : [ "string", "null" ]
      },
      "insertionFromConstruct" : {
        "title" : "Is the insertion due to insertion of construct or other species DNA?",
        "type" : [ "boolean", "null" ]
      },
      "insertionFromMutagenesis" : {
        "title" : "Is the insertion a consequence of mutagenesis (CRISPR or TALEN)?",
        "type" : [ "boolean", "null" ]
      },
      "insertionSizeBp" : {
        "title" : "Insertion size (bp)",
        "type" : [ "number", "null" ]
      },
      "lesionSizeBp" : {
        "title" : "Lesion size (bp)",
        "type" : [ "number", "null" ]
      },
      "lesionType" : {
        "maxLength" : 255,
        "title" : "Lesion Type",
        "type" : [ "string", "null" ]
      },
      "mutatedAminoAcids" : {
        "maxLength" : 2000,
        "title" : "Mutated amino acids",
        "type" : [ "string", "null" ]
      },
      "mutatedAminoAcidsHgvs" : {
        "maxLength" : 2000,
        "title" : "Mutated amino acids (HGVS)",
        "type" : [ "string", "null" ]
      },
      "nucleotideChange" : {
        "maxLength" : 2000,
        "title" : "Nucleotide change",
        "type" : [ "string", "null" ]
      },
      "talenSequence" : {
        "maxLength" : 5000,
        "title" : "TALEN sequence",
        "type" : [ "string", "null" ]
      },
      "threePrimeFlank" : {
        "maxLength" : 5000,
        "title" : "3′ flanking sequence",
        "type" : [ "string", "null" ]
      },
      "transcriptConsequences" : {
        "items" : {
          "type" : "string"
        },
        "title" : "Transcript consequences",
        "type" : "array"
      },
      "transgeneSequence" : {
        "maxLength" : 5000,
        "title" : "Transgene sequence",
        "type" : [ "string", "null" ]
      }
    },
    "required" : [ "lesionType" ],
    "type" : "object"
  },
  "uiSchema" : {
    "elements" : [ {
      "elements" : [ {
        "options" : {
          "refreshesParent" : true,
          "standardLabels" : [ "Point Mutation", "Deletion", "Insertion", "Indel", "Transgene", "Unknown" ],
          "standardValues" : [ "point_mutation", "deletion", "insertion", "indel", "transgene", "unknown" ],
          "widget" : "selectWithOther"
        },
        "scope" : "#/properties/lesionType",
        "type" : "Control"
      } ],
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "noOther" : true,
          "standardValues" : [ "A>T", "A>C", "A>G", "T>A", "T>C", "T>G", "C>A", "C>T", "C>G", "G>A", "G>T", "G>C" ],
          "widget" : "selectWithOther"
        },
        "scope" : "#/properties/nucleotideChange",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "point_mutation" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "constantValue" : 1,
          "suffix" : "bp",
          "widget" : "autoSize"
        },
        "scope" : "#/properties/lesionSizeBp",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "point_mutation" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "widget" : "yesNoRadio"
        },
        "scope" : "#/properties/insertionFromMutagenesis",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "insertion" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "multi" : true,
          "widget" : "nucleotideSequence"
        },
        "scope" : "#/properties/crisprSequence",
        "type" : "Control"
      }, {
        "options" : {
          "multi" : true,
          "widget" : "nucleotideSequence"
        },
        "scope" : "#/properties/talenSequence",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "conditions" : [ {
            "schema" : {
              "enum" : [ "insertion" ]
            },
            "scope" : "#/properties/lesionType"
          }, {
            "schema" : {
              "const" : true
            },
            "scope" : "#/properties/insertionFromMutagenesis"
          } ],
          "type" : "AND"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "widget" : "yesNoRadio"
        },
        "scope" : "#/properties/insertionFromConstruct",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "insertion" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "placeholder" : "e.g. Tg(fli1a:EGFP)"
        },
        "scope" : "#/properties/constructName",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "conditions" : [ {
            "schema" : {
              "enum" : [ "insertion" ]
            },
            "scope" : "#/properties/lesionType"
          }, {
            "schema" : {
              "const" : true
            },
            "scope" : "#/properties/insertionFromConstruct"
          } ],
          "type" : "AND"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "multi" : true
        },
        "scope" : "#/properties/deletedSequence",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "deletion", "indel" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "sourceField" : "deletedSequence",
          "suffix" : "bp",
          "widget" : "autoSize"
        },
        "scope" : "#/properties/lesionSizeBp",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "deletion", "indel" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "multi" : true
        },
        "scope" : "#/properties/insertedSequence",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "insertion", "indel" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "sourceField" : "insertedSequence",
          "suffix" : "bp",
          "widget" : "autoSize"
        },
        "scope" : "#/properties/insertionSizeBp",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "insertion", "indel" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "multi" : true
        },
        "scope" : "#/properties/transgeneSequence",
        "type" : "Control"
      }, {
        "options" : {
          "widget" : "yesNoRadio"
        },
        "scope" : "#/properties/hasLargeVariant",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "transgene" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "helpText" : "At least 20 nt directly preceding the lesion / transgene.",
          "infoHref" : "https://wiki.zfin.org/display/general/Transgene+Insertion+Sequence+Conventions",
          "multi" : true
        },
        "scope" : "#/properties/fivePrimeFlank",
        "type" : "Control"
      }, {
        "options" : {
          "helpText" : "At least 20 nt directly following the lesion / transgene.",
          "infoHref" : "https://wiki.zfin.org/display/general/Transgene+Insertion+Sequence+Conventions",
          "multi" : true
        },
        "scope" : "#/properties/threePrimeFlank",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "point_mutation", "deletion", "insertion", "indel", "transgene" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "placeholder" : "e.g. p.Gly12Val"
        },
        "scope" : "#/properties/mutatedAminoAcids",
        "type" : "Control"
      }, {
        "options" : {
          "placeholder" : "HGVS protein notation"
        },
        "scope" : "#/properties/mutatedAminoAcidsHgvs",
        "type" : "Control"
      } ],
      "rule" : {
        "condition" : {
          "schema" : {
            "enum" : [ "point_mutation" ]
          },
          "scope" : "#/properties/lesionType"
        },
        "effect" : "SHOW"
      },
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "addLabel" : "+ Add consequence",
          "helpText" : "Add one entry per consequence.",
          "vocabulary" : "transcript_consequence_term",
          "widget" : "vocabularyMultiSelect"
        },
        "scope" : "#/properties/transcriptConsequences",
        "type" : "Control"
      } ],
      "type" : "Group"
    }, {
      "elements" : [ {
        "options" : {
          "multi" : true
        },
        "scope" : "#/properties/additionalInfo",
        "type" : "Control"
      } ],
      "type" : "Group"
    } ],
    "type" : "VerticalLayout"
  }
}